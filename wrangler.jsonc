{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mg-translater-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SESSION_COOKIE_NAME": "mg_session",
    "SESSION_TTL_DAYS": "30",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174",
    "OAUTH_REDIRECT_ALLOWLIST": "http://localhost:5173/auth/callback,http://localhost:5174/auth/callback,http://127.0.0.1:5173/auth/callback,http://127.0.0.1:5174/auth/callback,mg-translater://auth/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mg-translater-db",
      "database_id": "c331e9b9-a243-4277-8d6e-70b1e8742f16",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "mg-translater-images"
    }
  ]
}
